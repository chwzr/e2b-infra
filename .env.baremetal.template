# ------------------------------------------- Required block -----------------------------------------------------------
# These variables are required and don't have default values.

# Your domain or subdomain, e.g. great-innovations.dev, e2b.great-innovations.dev
# (DNS is NOT managed by Terraform — create a wildcard A record for *.$DOMAIN_NAME
# pointing at your ingress server's public address after terraform apply.)
DOMAIN_NAME=

# Custom container registry URL, e.g. registry.example.com
# The registry must be reachable from all servers via the private network.
CONTAINER_REGISTRY_URL=
# Registry credentials (leave empty for an anonymous/public registry). Written to
# /root/docker/config.json on every node as base64(user:pass) so Nomad can pull.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ------------------------------------------- Required with defaults ---------------------------------------------------

PROVIDER=baremetal
# Prefix identifier for all resources
PREFIX=e2b-

# prod, staging, dev
TERRAFORM_ENVIRONMENT=dev

# ------------------------------------------- Per-pool server IPs (NOT here) -------------------------------------------
# IMPORTANT: the per-nodepool private IPs are LISTS and are supplied via the
# Terraform var-file, NOT this .env. Copy iac/provider-baremetal/.terraform.example.tfvars
# to iac/provider-baremetal/.terraform.<env>.tfvars and fill in:
#   control_server_ips, api_ips, ingress_ips, orchestrator_ips, build_ips, clickhouse_ips
# Cluster sizes are derived from the length of each list — there are no
# *_CLUSTER_SIZE / *_CPU_CORES / *_MEMORY_MB variables (servers are pre-provisioned).

# ------------------------------------------- S3-compatible storage ----------------------------------------------------
# Hetzner Object Storage (or any S3-compatible endpoint) — used for both the
# Terraform state backend and the runtime buckets (kernels, templates, loki, etc.)

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
# Already-provisioned bucket that holds the Terraform state (one-time manual setup).
S3_BUCKET=

# ------------------------------------------- SSH access --------------------------------------------------------------
# Terraform connects as root over SSH to each server's private IP to run the
# bootstrap (install + configure). The matching PUBLIC key must already be on
# root@ each server (a prerequisite of this provider — there is no SSH_PUBLIC_KEY
# variable). `terraform apply` must run from somewhere with SSH reachability to
# the private network (directly, or via VPN / the optional bastion below).
#
# SSH_PRIVATE_KEY may be a PATH to a PEM file (preferred — Make's -include can't
# parse multi-line values) OR the inline PEM content.
SSH_PRIVATE_KEY=~/.ssh/e2b-baremetal

# Optional SSH bastion / jump host (leave empty for direct access).
SSH_BASTION_HOST=
SSH_BASTION_USER=root

# ------------------------------------------- Tool versions (optional) -----------------------------------------------
# Installed by setup-base.sh at first bootstrap. Defaults shown — uncomment to pin.
# CONSUL_VERSION=1.16.2
# NOMAD_VERSION=1.6.2
# VAULT_VERSION=1.20.3

# ------------------------------------------- Ingress TLS (optional) --------------------------------------------------
# Let's Encrypt contact email; empty disables TLS on the Traefik ingress.
ACME_EMAIL=
# Override the Traefik image (needs bash+curl+jq when using the hcloud DNS-01 script).
# INGRESS_IMAGE=traefik:v3.5
# Hetzner DNS-01 wildcard cert (optional). When set, Traefik issues *.DOMAIN via DNS-01.
HCLOUD_TOKEN=
HCLOUD_ZONE=
HCLOUD_ZONE_ID=

# ------------------------------------------- Nomad provider address (first bootstrap) -------------------------------
# Leave empty to use https://nomad.$DOMAIN_NAME. On the very first deploy Traefik
# isn't running yet, so set this to a direct Nomad listener through an SSH tunnel
# to a control server, e.g. http://localhost:4646 (see self-host-baremetal.md).
NOMAD_ADDRESS=

# Managed Redis (true) vs. the in-cluster Redis Nomad job (false).
REDIS_MANAGED=false

# ------------------------------------------- Application Secrets -----------------------------------------------------
# Passed via environment, stored in Terraform state (sensitive).

POSTGRES_CONNECTION_STRING=
SUPABASE_JWT_SECRETS=
LAUNCH_DARKLY_API_KEY=

GRAFANA_OTLP_URL=
GRAFANA_OTEL_COLLECTOR_TOKEN=
GRAFANA_USERNAME=
GRAFANA_LOGS_USER=
GRAFANA_LOGS_URL=
GRAFANA_LOGS_COLLECTOR_API_TOKEN=
