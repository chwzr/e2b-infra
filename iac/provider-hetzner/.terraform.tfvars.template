# Hetzner Provider - Terraform Variables Template
# Copy this file to .terraform.{env}.tfvars and fill in the values.
# Variables set in .env.{env} via TF_VAR_ are automatically passed and don't need to be repeated here.
# This file is for secrets and values that should NOT be in the .env file.

# ------------------------------------------- Required -----------------------------------------------------------

# SSH public key for cluster node access (Cloud VMs)
ssh_public_key = ""

# PostgreSQL connection string (required)
# e.g. "postgresql://user:password@host:5432/dbname?sslmode=require"
# postgres_connection_string = ""

# Supabase JWT secret (required for E2B dashboard)
# Get from: Supabase Dashboard > Project Settings > Data API > JWT Settings
# supabase_jwt_secrets = ""

# ------------------------------------------- Orchestrator (Dedicated Servers) -----------------------------------

# SSH private key for dedicated server provisioning (the private key matching your Robot server SSH setup)
# orchestrator_ssh_private_key = <<-EOT
# -----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----
# EOT

# Public IPs of dedicated servers
# orchestrator_server_ips = ["1.2.3.4", "5.6.7.8"]

# vSwitch ID from Hetzner Robot
# vswitch_id = 12345

# Private IPs of control server nodes (needed for dedicated server Consul join)
# After first `make apply`, get these from the Hetzner Cloud Console > Servers > private IPs
# consul_retry_join_ips = ["10.0.0.2", "10.0.0.3", "10.0.0.4"]

# ------------------------------------------- Optional (Monitoring) -----------------------------------------------

# Grafana Cloud (for observability)
# grafana_otlp_url             = "https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
# grafana_otel_collector_token = ""
# grafana_username             = ""
# grafana_logs_user            = ""
# grafana_logs_url             = "https://logs-prod-us-east-0.grafana.net"
# grafana_logs_collector_api_token = ""

# LaunchDarkly (for feature flags)
# launch_darkly_api_key = ""
