#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: e2b-base
    username: root
    # packer (bcrypt), overridden post-install by the per-VM cloud-init SSH key
    password: "$6$rounds=4096$aaaaaaaaa$4BI4jDK8NTdcWupRuD2EyQ1yCCoMJJpbDFSEJFzN7tBsZvkbpgLP5gW/7g6Go6AKbMqmv6MTe5KM12VRhljN70"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: direct
  packages:
    - qemu-guest-agent
    - openssh-server
    - curl
    - ca-certificates
  user-data:
    disable_root: false
    runcmd:
      - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config
      - systemctl restart ssh
  late-commands:
    - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /target/etc/ssh/sshd_config
    - echo 'root:packer' | chroot /target chpasswd
