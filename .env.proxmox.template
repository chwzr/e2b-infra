# ------------------------------------------- Required block -----------------------------------------------------------
# These variables are required and don't have default values.

# Your domain or subdomain, e.g. great-innovations.dev, e2b.great-innovations.dev
# (DNS is NOT managed by Terraform — create a wildcard A record for *.$DOMAIN_NAME
# pointing at INGRESS_PUBLIC_IP after terraform apply.)
DOMAIN_NAME=

# Custom container registry URL, e.g. registry.example.com
# The registry must be reachable from all VMs via the private network.
CONTAINER_REGISTRY_URL=

# ------------------------------------------- Required with defaults ---------------------------------------------------

PROVIDER=proxmox
# Prefix identifier for all resources
PREFIX=e2b-

# prod, staging, dev
TERRAFORM_ENVIRONMENT=dev

# ------------------------------------------- S3-compatible storage ----------------------------------------------------
# Hetzner Object Storage (or any S3-compatible endpoint) — used for both the
# Terraform state backend and the runtime buckets (kernels, templates, loki, etc.)

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
# Already-provisioned bucket that holds the Terraform state (one-time manual setup).
S3_BUCKET=

# ------------------------------------------- Proxmox -----------------------------------------------------------------

# API endpoint — include /api2/json
PROXMOX_API_URL=https://pve.example.com:8006/api2/json
# API token ID in the form user@realm!tokenname (e.g. root@pam!terraform)
PROXMOX_API_TOKEN_ID=
PROXMOX_API_TOKEN_SECRET=
# Set true if the PVE API uses a self-signed cert
PROXMOX_TLS_INSECURE=false

# Target PVE node (single-host deployment)
PVE_NODE=pve
# Storage pool for VM disks
PVE_STORAGE_POOL=local-lvm

# Name of the Packer-built base VM template that all node pools clone from.
# (See iac/provider-proxmox/nomad-cluster-disk-image for the Packer build.)
BASE_TEMPLATE=e2b-nomad-cluster

# ------------------------------------------- Networking --------------------------------------------------------------
# Two bridges must already exist on the PVE host:
#   - public bridge with routable public IPv4 (used only by the ingress VM)
#   - private bridge for the cluster (host masquerades egress, see
#     https://community.hetzner.com/tutorials/install-and-configure-proxmox_ve#23-vswitch-with-a-public-subnet)

PUBLIC_BRIDGE=vmbr0
PRIVATE_BRIDGE=vmbr1
PRIVATE_SUBNET_CIDR=10.0.0.0/24
PRIVATE_GATEWAY_IP=10.0.0.1

# ------------------------------------------- Ingress VM (single dual-NIC node) ---------------------------------------
# The ONE VM that gets a public IP. Point your wildcard DNS record here.

INGRESS_PUBLIC_IP=
INGRESS_PUBLIC_GATEWAY=
INGRESS_PUBLIC_CIDR_BIT=24

# ------------------------------------------- SSH access --------------------------------------------------------------
# SSH key used for VM cloud-init + Terraform remote-exec bootstrap.
# `terraform apply` must run from somewhere with SSH reachability to the private
# subnet (typically the Proxmox host, or a VPN-connected workstation).

SSH_PUBLIC_KEY=
SSH_PRIVATE_KEY=

# ------------------------------------------- Cluster sizes & per-pool VM sizing -------------------------------------
# Every node pool is a pool of Proxmox VMs cloned from BASE_TEMPLATE. Tune count
# and per-VM CPU / RAM / disk per pool. Defaults are small/dev-sized — scale up
# for production.

# Control server (Nomad + Consul servers). Use an odd number for Raft quorum.
CONTROL_SERVER_CLUSTER_SIZE=3
CONTROL_SERVER_CPU_CORES=2
CONTROL_SERVER_MEMORY_MB=4096
CONTROL_SERVER_DISK_SIZE_GB=20

# API pool (API, client-proxy, OTEL, Loki, logs-collector).
API_CLUSTER_SIZE=1
API_CPU_CORES=2
API_MEMORY_MB=4096
API_DISK_SIZE_GB=20

# Ingress (single dual-NIC VM running Traefik). Always 1 instance.
INGRESS_CPU_CORES=2
INGRESS_MEMORY_MB=2048
INGRESS_DISK_SIZE_GB=20

# Orchestrator pool (Firecracker sandbox runner, nested KVM).
# Size generously — CPU / RAM here caps how many sandboxes fit per VM.
ORCHESTRATOR_CLUSTER_SIZE=1
ORCHESTRATOR_CPU_CORES=8
ORCHESTRATOR_MEMORY_MB=16384
ORCHESTRATOR_DISK_SIZE_GB=100

# Build pool (template-manager, nested KVM). I/O-bound.
BUILD_CLUSTER_SIZE=1
BUILD_CPU_CORES=8
BUILD_MEMORY_MB=16384
BUILD_DISK_SIZE_GB=100

# ClickHouse pool. DATA_VOLUME is a second virtio disk mounted at /clickhouse.
CLICKHOUSE_CLUSTER_SIZE=1
CLICKHOUSE_CPU_CORES=4
CLICKHOUSE_MEMORY_MB=8192
CLICKHOUSE_DISK_SIZE_GB=20
CLICKHOUSE_DATA_VOLUME_SIZE_GB=100

REDIS_MANAGED=false

# ------------------------------------------- Application Secrets -----------------------------------------------------
# Same secrets as the Hetzner provider — passed via environment, stored in
# Terraform state (sensitive).

POSTGRES_CONNECTION_STRING=
SUPABASE_JWT_SECRETS=
LAUNCH_DARKLY_API_KEY=

GRAFANA_OTLP_URL=
GRAFANA_OTEL_COLLECTOR_TOKEN=
GRAFANA_USERNAME=
GRAFANA_LOGS_USER=
GRAFANA_LOGS_URL=
GRAFANA_LOGS_COLLECTOR_API_TOKEN=
