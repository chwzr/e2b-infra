# ------------------------------------------- Required block -----------------------------------------------------------
# These variables are required and don't have default values
# You must provide values for these to run the deployment successfully

HCLOUD_TOKEN=

# your domain or subdomain name, eg great-innovations.dev, e2b.great-innovations.dev
DOMAIN_NAME=

# Custom container registry URL, eg registry.example.com
CONTAINER_REGISTRY=

# ------------------------------------------- Required with defaults ---------------------------------------------------
# These variables need to be specified but have default values

PROVIDER=hetzner
# prefix identifier for all resources
PREFIX=e2b-

# prod, staging, dev
TERRAFORM_ENVIRONMENT=dev

# ------------------------------------------- S3-compatible storage ----------------------------------------------------
# Hetzner Object Storage or any S3-compatible endpoint for Terraform state and buckets

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=

# ------------------------------------------- Orchestrator (Hetzner Dedicated Servers) ---------------------------------
# Dedicated servers run the Firecracker orchestrator (KVM not available on Cloud VMs).
# Create a vSwitch in Hetzner Robot, attach your dedicated servers to it.

# vSwitch ID from Hetzner Robot
VSWITCH_ID=
# VLAN ID assigned to the vSwitch (4000-4091)
VSWITCH_VLAN_ID=4000
# Comma-separated public IPs of dedicated servers (for SSH provisioning)
ORCHESTRATOR_SERVER_IPS=
# SSH private key for dedicated server access
ORCHESTRATOR_SSH_PRIVATE_KEY=
# Comma-separated private IPs of Consul server nodes (for dedicated server retry_join)
CONSUL_RETRY_JOIN_IPS=

# ------------------------------------------- Build Pool (Hetzner Dedicated Servers) -----------------------------
# Template-manager runs Firecracker to build sandbox templates — requires KVM.
# Hetzner Cloud VMs don't support nested virtualization, so the build pool
# also runs on dedicated servers. Attach them to the same vSwitch as the
# orchestrator servers (they share VLAN and subnet; IPs auto-assigned from
# the .100+ range to avoid collision with orchestrator IPs).

# Comma-separated public IPs of dedicated build servers (for SSH provisioning)
BUILD_SERVER_IPS=
# SSH private key for build server access (leave empty to reuse ORCHESTRATOR_SSH_PRIVATE_KEY)
BUILD_SSH_PRIVATE_KEY=
